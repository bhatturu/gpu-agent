DOCKER_REGISTRY ?= registry.test.pensando.io:5000
INSECURE_REGISTRY = $(DOCKER_REGISTRY)
DOCKER_BUILDER_TAG = v1.11
BUILD_BASE_IMAGE = $(DOCKER_REGISTRY)/ubuntu:22.04
RHEL_BASE_MIN_IMAGE = $(DOCKER_REGISTRY)/ubi9/ubi-minimal:9.6
TESTRUNNER_RHEL_BASE_IMAGE = $(DOCKER_REGISTRY)/ubi9/ubi:9.6
EXPORTER_SRIOV_BASE_IMAGE = $(DOCKER_REGISTRY)/ubi9/ubi-minimal:9.6
AZURE_BASE_IMAGE = $(DOCKER_REGISTRY)/azurelinux/coreos:3.0
AMDSMI_BASE_IMAGE = $(DOCKER_REGISTRY)/ubi9/ubi:9.4
AMDSMI_BASE_UBUNTU22 = $(BUILD_BASE_IMAGE)
AMDSMI_BASE_UBUNTU24 = $(DOCKER_REGISTRY)/ubuntu:24.04
AMDSMI_BASE_AZURE = $(AZURE_BASE_IMAGE)
GPUAGENT_BASE_IMAGE = $(BUILD_BASE_IMAGE)
ROCPROFILER_BASE_UBUNTU22 = $(DOCKER_REGISTRY)/ubuntu:22.04

GPUAGENT_BUILDER_IMAGE = $(DOCKER_REGISTRY)/gpuagent-builder:v1

# ROCm 7.12 therock nightly tarball URL (used by docker-cicd and docker-test-runner-cicd
# targets when repo.radeon.com packages are not available). Update this to the latest
# nightly build number when a new release is available.
ROCM_TARBALL_URL = https://therock-nightly-tarball.s3.amazonaws.com/therock-dist-linux-gfx950-dcgpu-7.12.0a20260225.tar.gz
